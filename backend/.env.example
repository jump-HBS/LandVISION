# ============================================================
# LandVISION 后端环境变量模板
# 复制本文件为 backend/.env 后按需修改（环境变量前缀 LANDVISION_）
# ============================================================

# ---------- 数据库（POSTGIS 模式） ----------
# 格式 postgresql+psycopg2://用户:密码@主机:端口/库名
LANDVISION_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/landvision

# ---------- 运行模式（可选） ----------
# 1 → 强制 DEMO 模式（内存数据，无需数据库）
# 0 → 强制 POSTGIS 模式（连接失败则降级 DEMO）
# 不设置 → 自动探测：数据库能连上就用 POSTGIS，否则用 DEMO
# LANDVISION_DEMO=1

# ---------- 安全 ----------
# CORS 允许的来源（逗号分隔）
# LANDVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 每 IP 每分钟请求上限（0=关闭限流）
# LANDVISION_RATE_LIMIT=120
# 操作审计日志（默认开启）
# LANDVISION_AUDIT_ENABLED=true

# ---------- 业务参数 ----------
# 估价缓冲区默认半径（米）
# LANDVISION_BUFFER_M=800
